# Variables para Docker Compose (docker compose up). Copiar a .env en la raíz del repo.
# Para desarrollo local sin Docker se usa backend/.env (ver backend/.env.example).

# Base de datos (contenedor postgres). El backend arma DATABASE_URL con estos valores.
# Cambiá DB_PASSWORD en producción (y en el DATABASE_URL de backend/.env si lo usás en dev).
DB_USER=arca
DB_PASSWORD=arca_dev_2024
DB_NAME=arca_facturacion

# Auth (obligatorio: compose no arranca sin JWT_SECRET). Generalo con: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ARCA (obligatorio: la CUIT que factura, 11 dígitos con dígito verificador válido).
# Los certificados generados desde la UI tienen que ser de esta CUIT y de este ambiente.
AFIP_CUIT=20123456786
AFIP_PUNTO_VENTA=1
# false = homologación, true = producción
AFIP_PRODUCTION=false
# Espera (ms) antes de consultar en ARCA una factura con resultado incierto
AFIP_RECOVERY_DELAY_MS=3000
# El certificado (/app/certs) y los Tickets de Acceso (/app/tickets) van en los volúmenes
# arca-certs y arca-tickets: sus rutas son fijas en docker-compose.yml.

# Orígenes permitidos por CORS (separados por coma). La UI se sirve desde el mismo origen
# que la API (nginx), así que solo hace falta para clientes web en otros dominios.
CORS_ORIGIN=http://localhost
# Saltos de proxy en los que confía Express (nginx = 1). Ver README.
TRUST_PROXY=1

# Puerto publicado por nginx
APP_PORT=80
