# Desarrollo local sin Docker (npm run dev). Copiar a backend/.env.
# Para Docker Compose se usa el .env de la raíz (ver ../.env.example).

PORT=3001

# Base de datos (obligatorio). Con `docker compose up -d postgres` el Postgres del compose
# queda en localhost:5433 con los valores por defecto de DB_USER/DB_PASSWORD/DB_NAME.
DATABASE_URL=postgresql://arca:arca_dev_2024@localhost:5433/arca_facturacion

# Auth
# JWT_SECRET es obligatorio: el server no arranca sin él. Generalo con: openssl rand -hex 32
JWT_SECRET=
# Duración del token (formato de jsonwebtoken: 7d, 12h...). Default: 7d
JWT_EXPIRES_IN=7d

# Orígenes permitidos por CORS, separados por coma. Default: http://localhost:5173 (Vite)
CORS_ORIGIN=http://localhost:5173
# Proxies en los que confía Express para X-Forwarded-For (rate limit por IP real).
# Sin definir o false: conexión directa (desarrollo). Detrás de nginx: 1.
# TRUST_PROXY=1

# ARCA
# CUIT que factura (11 dígitos, se valida el dígito verificador). Los certificados que se
# generan desde la UI tienen que ser de esta CUIT y del ambiente de AFIP_PRODUCTION.
AFIP_CUIT=20123456786
# Certificado y clave (rutas relativas al directorio desde el que corre el server: backend/).
# Default: backend/certs/cert.crt y backend/certs/key.key. Generar certificado los escribe acá.
AFIP_CERT_PATH=./certs/cert.crt
AFIP_KEY_PATH=./certs/key.key
AFIP_PUNTO_VENTA=1
# false = homologación (default), true = producción
AFIP_PRODUCTION=false
# Directorio de los Tickets de Acceso de WSAA (contiene token/sign: tratalo como secreto).
# Default: backend/certs/tickets
AFIP_TICKETS_DIR=./certs/tickets
# Espera (ms) antes de consultar en ARCA una factura con resultado incierto. Default: 3000
AFIP_RECOVERY_DELAY_MS=3000
